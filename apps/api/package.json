{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/lambda.ts --bundle --format=esm --platform=node --target=node24 --outfile=dist/index.mjs",
    "dev": "tsx watch src/local.ts",
    "start": "tsx src/local.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/api-contract": "workspace:*",
    "@hono/node-server": "2.1.0",
    "@hono/zod-validator": "0.9.0",
    "hono": "4.13.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/aws-lambda": "8.10.162",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.1",
    "tsx": "4.23.9",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
