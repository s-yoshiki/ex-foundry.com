{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/lambda.ts --bundle --format=esm --platform=node --target=node24 --outfile=dist/index.mjs",
    "dev": "tsx watch src/local.ts",
    "start": "tsx src/local.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/api-contract": "workspace:*",
    "@hono/node-server": "2.1.4",
    "@hono/zod-validator": "0.9.1",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
