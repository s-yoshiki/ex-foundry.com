{
  "name": "ex-foundry.com",
  "private": true,
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "turbo run build",
    "deploy": "pnpm --filter @repo/infra deploy",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check-types": "pnpm typecheck",
    "create:feature": "pnpm --filter @repo/create-feature start",
    "dev": "turbo run dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm verify:biome-config && pnpm check && pnpm typecheck && pnpm test && pnpm build",
    "verify:biome-config": "node scripts/verify-biome-config.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "turbo": "2.10.10",
    "typescript": "7.0.2"
  }
}
