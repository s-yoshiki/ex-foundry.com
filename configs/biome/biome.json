{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "root": false,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!!**/build",
      "!!**/coverage",
      "!!**/out",
      "!!**/cdk.out",
      "!!**/.next",
      "!!**/.react-router",
      "!!**/.turbo",
      "!!**/node_modules",
      "!!**/*.tsbuildinfo",
      "!!apps/*/public/**/*.svg",
      "!!.claude"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "domains": {
      "drizzle": "none",
      "next": "none",
      "playwright": "none",
      "project": "none",
      "qwik": "none",
      "react": "all",
      "reactNative": "none",
      "solid": "none",
      "svelte": "none",
      "tailwind": "all",
      "test": "all",
      "turborepo": "all",
      "types": "all",
      "vue": "none"
    },
    "rules": {
      "preset": "all"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
